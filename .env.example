# Active environment database. SQLite is for local development only.
DATABASE_URL="file:./dev.db"

# Required by Auth.js at runtime. Generate a different strong secret per environment.
AUTH_SECRET="replace-with-a-secure-random-secret"
AUTH_TRUST_HOST="true"

# Server-only Cloudinary credentials for authenticated administrator uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Bootstrap-only inputs for `npm run admin:create`.
# Remove real values from the environment after the account is created.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
